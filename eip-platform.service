[Unit]
Description=Edge Infrastructure Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/eip
EnvironmentFile=/opt/eip/.env
ExecStart=/opt/eip/.venv/bin/python /opt/eip/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
