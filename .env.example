# Flask platform
EIP_HOST=0.0.0.0
EIP_PORT=5000
EIP_DEBUG=false

# Hub status probe
EIP_HUB_HOST=hub.tailnet.example
EIP_HUB_PORT=3389
EIP_STATUS_TIMEOUT=2

# Wake command executed on the Pi control plane.
# Replace with the local command that sends the magic packet.
EIP_WAKE_COMMAND=wakepc hub

# Optional Windows operator actions.
EIP_RDP_HOST=hub
EIP_WAKE_RDP_SCRIPT=%USERPROFILE%\Scripts\wake_and_rdp.bat
EIP_WAKE_BACKUP_SCRIPT=%USERPROFILE%\Scripts\wake_and_backup.bat
